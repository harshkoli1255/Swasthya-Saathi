# SwasthyaSaathi environment variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# --- PostgreSQL ---
POSTGRES_USER=swasthya
POSTGRES_PASSWORD=swasthya_dev
POSTGRES_DB=swasthyasaathi
DATABASE_URL=postgresql://swasthya:swasthya_dev@localhost:5432/swasthyasaathi

# --- Security ---
SECRET_KEY=CHANGE_ME_use_a_long_random_string_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- MinIO (S3-compatible object storage) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=swasthya_minio
MINIO_SECRET_KEY=swasthya_minio_secret
MINIO_BUCKET_DOCUMENTS=documents
MINIO_SECURE=false

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Data Retention (days) — placeholder defaults; update per institutional policy ---
RETENTION_DAYS_PATIENT=365
RETENTION_DAYS_AUDIO=90
RETENTION_DAYS_DOCUMENTS=365
RETENTION_DAYS_AUDIT_LOG=2555

# --- AI Providers ---
# Primary: Ollama (local) — install separately at https://ollama.com
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Optional cloud fallback (verify free-tier quotas before relying on these)
GROQ_API_KEY=
GEMINI_API_KEY=

# --- Feature Flags ---
FEATURE_CLOUD_AI_FALLBACK=false
FEATURE_ABDM_SANDBOX=false

# --- Environment ---
ENVIRONMENT=development
DEBUG=true
